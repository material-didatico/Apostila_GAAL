% Title page - Gentle Madness
%------------------------------------------------------------------------------%

\newcommand{\MakeTitlePage}%
{%
    \thispagestyle{empty}
    \hbox{%
        \hspace*{0.1\textwidth}%
        {\color{blue}\rule{1.5pt}{\textheight} \rule{1pt}{\textheight}}
        \hspace*{0.1\textwidth}%
        \parbox[b]{0.75\textwidth}{
            \vbox{%
                \vspace{0.1\textheight}\noindent%
                {\Large\itshape Notas de Aula} \\[2\baselineskip]
                {\huge\bfseries Geometria Analítica e \\[0.5\baselineskip]Álgebra Vetorial} \\[4\baselineskip]
                {\Large \bfseries \@author} \par
                \vspace{0.5\textheight}
                {\noindent CEFET-MG \hfill \today}\\[\baselineskip]
            }% end of vbox
        }% end of parbox
    }% end of hbox
}

% Titles configuration
%------------------------------------------------------------------------------%

\RequirePackage[explicit]{titlesec}

\font\bigrm = cmr10 at 40pt
\titleformat{name=\chapter}[display]
            {}
            {\rightline{\normalfont\bigrm{\thechapter}}}
            {-1cm}                                
            {\normalfont\Huge\textsc{#1}}
            [{\vspace{-5mm}\hrulefill\\[.8ex]}]

\titleformat{name=\chapter,numberless}[display]
            {}
            {}
            {-1cm}                                
            {\normalfont\Huge\textsc{#1}}
            [{\vspace{-5mm}\hrulefill\\[.8ex]}]
             
\titleformat{name=\section}
            {\normalfont\bfseries\fontsize{12.8}{14}\selectfont}
            {}
            {0pt}
            {%
%                \needspace{5\baselineskip}
                \begin{tcolorbox}[colback=red!5!white,%
                    colframe=red!50!black,%
                    colbacktitle=red!75!black]%
                    \thesection\hskip0.7em{#1}%
                \end{tcolorbox}%
            }

\titleformat{name=\section,numberless}
{\normalfont\bfseries\fontsize{12.8}{14}\selectfont}
{}{0pt}
{%
%    \needspace{5\baselineskip}
    \begin{tcolorbox}[colback=red!5!white,%
        colframe=red!50!black,%
        colbacktitle=red!75!black]%
        {#1}%
    \end{tcolorbox}%
}

\titlespacing{\chapter}{0cm}{0cm}{0cm}
\titlespacing{\section}{0cm}{0cm}{-\baselineskip}

% Page header configuration
\RequirePackage{fancyhdr}

\renewcommand*{\chaptermark}[1]{\markboth{#1}{#1}}
\renewcommand*{\sectionmark}[1]{}

\lhead[\fancyplain{}{\bfseries\thepage}]{\fancyplain{}{\small\slshape\bfseries\textit{\nouppercase{\leftmark}}}}
\rhead[\fancyplain{}{\small\slshape\bfseries\textit{\nouppercase{\rightmark}}}]{\fancyplain{}{\bfseries\thepage}}
\cfoot[\fancyplain{\bfseries\thepage}{}]{\fancyplain{\bfseries\thepage}{}}

\renewcommand*{\headrulewidth}{0.3pt}                       
\setlength{\headheight}{15pt}

