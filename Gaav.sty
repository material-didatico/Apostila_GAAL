\newenvironment{exFormat}%
{%
    \begin{small}%
    \begin{spacing}{1}%
        \begingroup%
        \setlength{\abovedisplayskip}{3pt}%
        \setlength{\belowdisplayskip}{3pt}%
            \begin{multicols}{2}%
            \raggedcolumns
            \begin{flushleft}%
            \vspace*{-3\baselineskip}%
}{%
            \end{flushleft}%
            \end{multicols}%
        \endgroup%
    \end{spacing}%
    \end{small}%
}

\newenvironment{ansFormat}%
{%
    \begin{scriptsize}%
    \begin{spacing}{1}%
        \begingroup%
        \setlength{\abovedisplayskip}{3pt}%
        \setlength{\belowdisplayskip}{3pt}%
        \begin{multicols}{2}%
        \raggedcolumns%
        \begin{flushleft}%
            \vspace*{-1\baselineskip}%
}{%
        \end{flushleft}%
        \end{multicols}%
        \endgroup%
    \end{spacing}%
    \end{scriptsize}%
}

\newenvironment{exercicios}[1]%
{
%    \needspace{5\baselineskip}
    \begin{small}
        \vspace*{-1\baselineskip}%
        \exsubsection{{#1}}%
        \setcounter{exercicio}{0}%
        \Writetofile{ans}{%
            \protect\exsubsection{#1}%
            \protect\begin{ansFormat}
        }%
        \begin{exFormat}%
}{%
        \end{exFormat}%
        \Writetofile{ans}{%
            \protect\end{ansFormat}%
        }%
    \end{small}
}

\newcommand*{\openAnswers} [1]{\Opensolutionfile{ans}[#1]}
\newcommand*{\writeAnswers}[1]{\Closesolutionfile{ans}\section{Respostas}\input{#1.aux}}

