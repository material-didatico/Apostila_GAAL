\newcommand*{\exsubsection}[1]{%
    \subsection*{#1}%
    \setcounter{exemplo}{0}
    \vspace*{-.8\baselineskip}%
    \noindent\hrulefill%
    \par%
    \vspace*{.4\baselineskip}%
}

\newenvironment{exemplos}[1][1]%
{
%    \needspace{5\baselineskip}
    \exsubsection{Exemplos}
    \begin{small}%
    \begin{spacing}{1}%
        \begingroup%    
        \setlength{\columnsep}{15pt}%
        \setlength{\abovedisplayskip}{3pt}%
        \setlength{\belowdisplayskip}{3pt}%
        \begin{multicols}{#1}%
            \raggedcolumns%
}{%
        \end{multicols}%
        \endgroup%
    \end{spacing}%
    \end{small}%
}

