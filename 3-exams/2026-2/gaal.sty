% Redefine alinhamento padrão das matrizes para a direita
\renewcommand*\env@matrix[1][r]%
{%
  \hskip -\arraycolsep
  \let\@ifnextchar\new@ifnextchar
  \array{*\c@MaxMatrixCols #1}%
}

\newenvironment{amatrix}[2][1]%
{%
  \left[\begin{array}{@{}*{#2}{r}|*{#1}{r}@{}}
}{%
  \end{array}\right]
}

