//-----------------------------------------------------------------------------

import "../../0-common/asy/utils.ah" as utils;

size(0, 70mm);

real xmin = -5;
real xmax = 15;
real ymin = -3;
real ymax =  9;

real a = 3.5;
real b = 1.5;

pen cc = darkolive;

//-----------------------------------------------------------------------------

draw( (xmin, 0)--(xmax, 0), cc, Arrows(7pt) );
draw( (0, ymin)--(0, ymax), cc, Arrows(7pt) );

label( "$X$", (xmax, -0.2), SW, cc );
label( "$Y$", (-0.2, ymax), SW, cc );

//-----------------------------------------------------------------------------

draw( scale(a, b) * unitcircle, pens[0] );

//-----------------------------------------------------------------------------
