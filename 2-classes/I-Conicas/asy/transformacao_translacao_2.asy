//-----------------------------------------------------------------------------

import "../../0-common/asy/utils.ah" as utils;

size(0, 70mm);

real xmin = -2;
real xmax =  9;
real ymin = -2;
real ymax =  9;

real h = 4;
real k = 5;
real r = 2;

pair A = (0, k);
pair B = (h, 0);
pair C = (h, k);

//-----------------------------------------------------------------------------

draw( (xmin, 0)--(xmax, 0), Arrows );
draw( (0, ymin)--(0, ymax), Arrows );

label( "$x$", (xmax, -0.2), SW );
label( "$y$", (-0.2, ymax), SW );

//-----------------------------------------------------------------------------

label( "$k$", A, NW );
label( "$h$", B, SE );

draw( A--C--B, gray );

//-----------------------------------------------------------------------------







//-----------------------------------------------------------------------------

draw( circle(C, r), pens[0]);
dot(C);

//-----------------------------------------------------------------------------
