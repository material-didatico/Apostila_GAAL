//-----------------------------------------------------------------------------

import "../../0-common/asy/utils.ah" as utils;

size(0, 70mm);

real xmin = -5;
real xmax = 15;
real ymin = -3;
real ymax =  9;

real a = 3.5;
real b = 1.5;

real h = 8.8;
real k = 2.8;

pair C = (h, k);

//-----------------------------------------------------------------------------

draw( (xmin, 0)--(xmax, 0), magenta, Arrows(7pt) );
draw( (0, ymin)--(0, ymax), magenta, Arrows(7pt) );

label( "$\mu$", (xmax, -0.2), SW, magenta );
label( "$\nu$", (-0.2, ymax), SW, magenta );

//-----------------------------------------------------------------------------

draw( (0, k)--(h, k)--(h, 0), gray );

label( "$r$", (h, 0), SE );
label( "$s$", (0, k), NW );

//-----------------------------------------------------------------------------

dot(C);

draw( shift(C) * scale(a, b) * unitcircle, pens[0] );

//-----------------------------------------------------------------------------
